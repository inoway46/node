+// Only the most recent node is retained for each SourceCode.
+const commentLookups = new WeakMap();
+const getJSDocComment = (sourceCode, node, settings) => {
+  const { minLines, maxLines, skipInvokedExpressionsForCommentFinding } = settings;
+  const previous = commentLookups.get(sourceCode);
+  if (previous && previous.node === node &&
+      previous.minLines === minLines && previous.maxLines === maxLines &&
+      previous.skipInvokedExpressionsForCommentFinding === skipInvokedExpressionsForCommentFinding) {
+    return previous.comment;
+  }
+  const comment = findJSDocComment(sourceCode, node, settings);
+  commentLookups.set(sourceCode, {
+    node, minLines, maxLines, skipInvokedExpressionsForCommentFinding, comment,
+  });
+  return comment;
+};
 
